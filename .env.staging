# TRIPLECHECK STAGING ENVIRONMENT CONFIGURATION
# ==============================================

# Application Environment
NODE_ENV=staging

# Database Configuration (Staging)
DATABASE_URL="postgresql://username:password@your-staging-db.com:5432/triplecheck_staging?sslmode=require"

# Database Connection Settings
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=60000
DB_ACQUIRE_TIMEOUT=90000
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1

# Security Configuration
JWT_SECRET="your-staging-jwt-secret-key-here"
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Server Configuration
PORT=3001
FRONTEND_URL="https://staging.your-domain.com"

# Email Configuration (Staging - can use test SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your-mailtrap-user"
SMTP_PASS="your-mailtrap-password"

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="jpg,jpeg,png,pdf,doc,docx"

# M-Pesa Configuration (Sandbox)
MPESA_CONSUMER_KEY="your-sandbox-mpesa-consumer-key"
MPESA_CONSUMER_SECRET="your-sandbox-mpesa-consumer-secret"
MPESA_BUSINESS_SHORT_CODE="174379"
MPESA_PASSKEY="your-sandbox-mpesa-passkey"
MPESA_ENVIRONMENT="sandbox"

# Google Maps API Key (can use same as production with restrictions)
VITE_GOOGLE_MAPS_API_KEY="your-staging-google-maps-api-key"

# Redis Configuration (if using Redis)
REDIS_URL="redis://your-staging-redis:6379"

# Monitoring and Logging (more verbose for staging)
LOG_LEVEL="debug"
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_TRACKING=true

# Security Headers
ENABLE_HELMET=true
ENABLE_CORS=true
CORS_ORIGIN="https://staging.your-domain.com"

# Rate Limiting (more lenient for testing)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Session Configuration
SESSION_SECRET="your-staging-session-secret"
SESSION_MAX_AGE=86400000

# Feature Flags (enable all for testing)
ENABLE_LAND_VERIFICATION=true
ENABLE_FRAUD_DETECTION=true
ENABLE_COMMUNITY_FEATURES=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_ANALYTICS=false

# External Service URLs (staging/sandbox)
LAND_REGISTRY_API_URL="https://staging-api.landregistry.go.ke"
FRAUD_DETECTION_API_URL="https://staging-api.frauddetection.service.com"

# CDN Configuration
CDN_URL="https://staging-cdn.your-domain.com"
STATIC_ASSETS_URL="https://staging-assets.your-domain.com"

# Backup Configuration
ENABLE_AUTOMATED_BACKUPS=false
BACKUP_SCHEDULE="0 4 * * *"
BACKUP_RETENTION_DAYS=7

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=1.0

# Error Reporting
SENTRY_DSN="https://your-staging-sentry-dsn@sentry.io/project-id"
SENTRY_ENVIRONMENT="staging"

# Analytics (disabled for staging)
GOOGLE_ANALYTICS_ID=""
ENABLE_ANALYTICS_TRACKING=false

# Demo/Test Data
ENABLE_DEMO_DATA=true
VITE_DEMO_USER_PASSWORD=demo123
VITE_DEMO_AGENT_PASSWORD=agent123