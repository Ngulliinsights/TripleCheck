+// ---- Helper functions extracted to reduce cognitive complexity ----
+
+/**
+ * Sanitizes route path for chunk naming with performance-optimized regex
+ * This replaces the previous slow regex pattern that could cause backtracking issues
+ */
+function sanitizeRoutePath(routePath: string): string {
+  // Use more specific regex patterns to avoid catastrophic backtracking
+  return routePath
+    .replace(/[^\w]/g, "-")  // Replace non-word characters with hyphens
+    .replace(/^-+/, "")      // Remove leading hyphens
+    .replace(/-+$/, "")      // Remove trailing hyphens
+    .replace(/-+/g, "-");    // Collapse multiple hyphens
+}
+
+/**
+ * Validates that a loaded module has the expected structure
+ * Extracted to improve readability and testability of the main function
+ */
+function validateModule(
+  module: ModuleWithDefault | undefined, 
+  routePath: string | undefined
+): asserts module is ModuleWithDefault {
+  if (!module || typeof module !== "object" || !module.default) {
+    throw new Error(
+      `Invalid module structure at ${routePath || "unknown route"}: missing default export`
+    );
+  }
+}
+
+/**
+ * Handles module import with retry logic for network failures
+ * Extracted from main function to reduce cognitive complexity and fix loop-function issues
+ */
+async function retryImport(
+  importFunction: () => Promise<ModuleWithDefault>,
+  routePath: string | undefined,
+  maxRetries: number = 2
+): Promise<ModuleWithDefault> {
+  let lastError: unknown;
+  
+  // Use traditional for loop with proper scoping to avoid closure issues
+  for (let attempt = 0; attempt <= maxRetries; attempt++) {
+    try {
+      return await importFunction();
+    } catch (err: unknown) {
+      lastError = err;
+      
+      // Check if this is a network-related error worth retrying
+      const isNetworkError = isRetryableNetworkError(err);
+      
+      if (attempt < maxRetries && isNetworkError) {
+        const routeInfo = routePath ? ` for ${routePath}` : "";
+        logger.warn(`Route load attempt ${attempt + 1} failed${routeInfo}, retrying...`);
+        
+        // Exponential backoff with proper timeout handling
+        await new Promise((resolve) => {
+          setTimeout(resolve, Math.pow(2, attempt) * 100);
+        });
+        continue;
+      }
+      
+      // If we've exhausted retries or it's not a network error, throw the error
+      throw err;
+    }
+  }
+  
+  // This should never be reached due to the throw in the loop, but TypeScript needs it
+  throw lastError || new Error("Unexpected error in retryImport");
+}
+
+/**
+ * Determines if an error is worth retrying based on its characteristics
+ * Separated for better testability and to avoid regex performance issues
+ */
+function isRetryableNetworkError(error: unknown): boolean {
+  if (!(error instanceof Error)) {
+    return false;
+  }
+  
+  // Use a more efficient approach than complex regex matching
+  const message = error.message.toLowerCase();
+  const retryableKeywords = ['loading chunk', 'chunkloaderror', 'fetch', 'network'];
+  
+  return retryableKeywords.some(keyword => message.includes(keyword));
+}
