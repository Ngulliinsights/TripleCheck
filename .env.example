# Environment Configuration for TripleCheck

# Database Configuration
# For local development (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/triplecheck

# For cloud databases (automatically uses SSL)
# DATABASE_URL=postgresql://username:password@your-cloud-db.com:5432/triplecheck

# For Neon (serverless PostgreSQL)
# DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/triplecheck?sslmode=require

# For Supabase
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Server Configuration
NODE_ENV=development
PORT=3001

# API Configuration
API_VERSION=v1

# Security
JWT_SECRET=your-jwt-secret-key-here

# External Services (optional)
# GOOGLE_MAPS_API_KEY=your-google-maps-key
# MPESA_CONSUMER_KEY=your-mpesa-key
# MPESA_CONSUMER_SECRET=your-mpesa-secret