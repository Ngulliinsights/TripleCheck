# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/triplecheck"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-here"

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Headless CMS Configuration
# Choose your CMS provider: 'strapi', 'contentful', 'sanity', 'ghost', 'directus', or 'local'
VITE_CMS_PROVIDER="local"

# Strapi Configuration (if using Strapi)
VITE_CMS_API_URL="http://localhost:1337"
VITE_CMS_API_KEY="your-strapi-api-key"

# Contentful Configuration (if using Contentful)
VITE_CONTENTFUL_SPACE_ID="your-contentful-space-id"
VITE_CONTENTFUL_ACCESS_TOKEN="your-contentful-access-token"

# Sanity Configuration (if using Sanity)
VITE_SANITY_PROJECT_ID="your-sanity-project-id"
VITE_SANITY_DATASET="production"

# Ghost Configuration (if using Ghost)
VITE_GHOST_API_URL="https://your-ghost-site.com"
VITE_GHOST_CONTENT_API_KEY="your-ghost-content-api-key"

# Directus Configuration (if using Directus)
VITE_DIRECTUS_API_URL="https://your-directus-instance.com"
VITE_DIRECTUS_API_KEY="your-directus-api-key"

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# M-Pesa Configuration (for Kenyan service payments only - NOT for property purchases)
# WARNING: M-Pesa payments are irreversible. Use only for service fees under KES 10,000
MPESA_CONSUMER_KEY="your-mpesa-consumer-key"
MPESA_CONSUMER_SECRET="your-mpesa-consumer-secret"
MPESA_BUSINESS_SHORT_CODE="your-business-short-code"
MPESA_PASSKEY="your-mpesa-passkey"
MPESA_ENVIRONMENT="sandbox"
MPESA_MAX_SAFE_AMOUNT="10000"

# Application Configuration
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12