{
  "extends": "./tsconfig.json",
  "include": [
    "server/infrastructure/**/*",
    "scripts/deployment/**/*",
    "docs/api/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "exactOptionalPropertyTypes": false
  }
}