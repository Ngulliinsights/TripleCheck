# Staging Environment Configuration for Request Deduplication System
# Copy this file to .env.staging and update with actual values

# Application Environment
NODE_ENV=staging
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/triplecheck_staging
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# Redis Configuration (Required for Request Deduplication)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=staging_redis_password
REDIS_DB=1
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# Request Deduplication Configuration
DEDUP_ENABLED=true
DEDUP_DEFAULT_TTL=300000
DEDUP_MAX_PENDING_TIME=30000
DEDUP_ENABLE_REDIS_BACKUP=true
DEDUP_KEY_PREFIX=staging-dedup:
DEDUP_CLEANUP_INTERVAL=60000

# Performance Monitoring Configuration
MONITORING_ENABLED=true
MONITORING_REFRESH_INTERVAL=5000
MONITORING_RETENTION_PERIOD=24
MONITORING_AUTO_OPTIMIZE=false

# Alert Configuration (Staging - less aggressive)
ALERT_EMAIL_RECIPIENTS=dev@triplecheck.co.ke
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/STAGING/WEBHOOK
SLACK_CHANNEL=#staging-alerts

# Performance Thresholds (Relaxed for staging)
PERF_THRESHOLD_HIT_RATE=0.6
PERF_THRESHOLD_MEMORY_USAGE=134217728
PERF_THRESHOLD_RESPONSE_TIME=1000
PERF_THRESHOLD_ERROR_RATE=0.1

# Security Configuration
JWT_SECRET=staging_jwt_secret_change_in_production
SESSION_SECRET=staging_session_secret_change_in_production
CORS_ORIGIN=http://localhost:3000,https://staging.triplecheck.co.ke

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_FILE_PATH=./logs/staging.log

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_ENDPOINT=/health
HEALTH_CHECK_TIMEOUT=5000