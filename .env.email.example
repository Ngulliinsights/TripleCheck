# Email Service Configuration for TripleCheck Kenya
# Copy this to your .env file and configure with your actual credentials

# =============================================================================
# EMAIL SERVICE PROVIDER SELECTION
# =============================================================================
# Choose your preferred email provider: smtp, sendgrid, gmail, outlook, mock
EMAIL_PROVIDER=smtp

# =============================================================================
# SMTP CONFIGURATION (Gmail, Outlook, or custom SMTP server)
# =============================================================================
# For Gmail: smtp.gmail.com, port 587
# For Outlook: smtp-mail.outlook.com, port 587
# For custom SMTP: your-smtp-server.com, port 587 or 465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# =============================================================================
# SENDGRID CONFIGURATION
# =============================================================================
# Get your API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key

# =============================================================================
# GMAIL API CONFIGURATION (OAuth2 - for advanced Gmail integration)
# =============================================================================
# Get credentials from https://console.developers.google.com/
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# =============================================================================
# OUTLOOK API CONFIGURATION (Microsoft Graph - for advanced Outlook integration)
# =============================================================================
# Get credentials from https://portal.azure.com/
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REFRESH_TOKEN=your-outlook-refresh-token

# =============================================================================
# EMAIL SENDER CONFIGURATION
# =============================================================================
FROM_EMAIL=noreply@triplecheck.co.ke
FROM_NAME=TripleCheck Kenya

# =============================================================================
# APPLICATION URLS
# =============================================================================
FRONTEND_URL=https://triplecheck.co.ke
BASE_URL=https://api.triplecheck.co.ke

# =============================================================================
# EMAIL SERVICE SETTINGS
# =============================================================================
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY=1000
EMAIL_BATCH_SIZE=10

# =============================================================================
# DEVELOPMENT/TESTING SETTINGS
# =============================================================================
# Set to true to enable email debugging
EMAIL_DEBUG=false

# Set to true to use mock email service (for development)
EMAIL_MOCK_MODE=false

# =============================================================================
# GMAIL SETUP INSTRUCTIONS
# =============================================================================
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to Google Account settings > Security > App passwords
# 3. Generate an app password for "Mail"
# 4. Use your Gmail address as SMTP_USER
# 5. Use the generated app password as SMTP_PASSWORD

# =============================================================================
# SENDGRID SETUP INSTRUCTIONS
# =============================================================================
# 1. Sign up at https://sendgrid.com/
# 2. Go to Settings > API Keys
# 3. Create a new API key with "Full Access" permissions
# 4. Copy the API key to SENDGRID_API_KEY
# 5. Verify your sender identity in SendGrid

# =============================================================================
# PRODUCTION RECOMMENDATIONS
# =============================================================================
# - Use SendGrid or AWS SES for high-volume production email
# - Set up proper SPF, DKIM, and DMARC records for your domain
# - Monitor email deliverability and bounce rates
# - Implement email templates for consistent branding
# - Use environment-specific configurations (dev/staging/prod)

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - Never commit real credentials to version control
# - Use environment variables or secure secret management
# - Rotate API keys and passwords regularly
# - Monitor for unauthorized email sending
# - Implement rate limiting for email endpoints