# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/

# Compiled TypeScript artifacts in source directories
# These should ONLY exist inside dist/ — never alongside .ts files
client/src/**/*.js
client/src/**/*.js.map
client/src/**/*.d.ts
client/src/**/*.d.ts.map
server/**/*.js
server/**/*.js.map
server/**/*.d.ts
server/**/*.d.ts.map
shared/**/*.js
shared/**/*.js.map
shared/**/*.d.ts
shared/**/*.d.ts.map
scripts/**/*.js
!scripts/logger.js
!scripts/generate-favicons.js
!scripts/emergency-stop.js
!scripts/run-accessibility-tests.js
!scripts/run-e2e-tests.js
!scripts/run-visual-tests.js
!scripts/run-complete-load-test.cjs
!scripts/memory-benchmark.js
tests/**/*.js
tests/**/*.js.map
tests/**/*.d.ts
tests/**/*.d.ts.map

# Source maps (global fallback)
*.js.map
*.d.ts.map

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# OS files
Thumbs.db
.DS_Store

# Temporary files
*.tmp
*.temp
.cache/

# Uploads (user generated content)
uploads/*
!uploads/.gitkeep

# Backup files (local development)
backup/

# Error logs from build
tsc_errors*.txt

# Temporary files from sed/shell operations
sed[a-zA-Z0-9]*

# Accidental compiler/build artifacts
*.error
*.errors

# Planning/analysis docs should NOT be committed to src/ — move to docs/ instead
client/src/**/*.md
server/**/*.md
!**/README.md
