# TripleCheck Kenya - Production Environment Configuration
# Copy this to .env and configure with your actual credentials

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
PORT=3000
BASE_URL=https://api.triplecheck.co.ke
FRONTEND_URL=https://triplecheck.co.ke

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/triplecheck
DB_HOST=localhost
DB_PORT=5432
DB_NAME=triplecheck
DB_USER=triplecheck_user
DB_PASSWORD=your_secure_password

# =============================================================================
# EMAIL SERVICE CONFIGURATION
# =============================================================================
# Choose provider: smtp, sendgrid, gmail, outlook, mock
EMAIL_PROVIDER=smtp

# SMTP Configuration (Gmail/Outlook/Custom)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@triplecheck.co.ke
SMTP_PASSWORD=your_app_password

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key

# Email Settings
FROM_EMAIL=noreply@triplecheck.co.ke
FROM_NAME=TripleCheck Kenya
EMAIL_DEBUG=false

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================
# Choose provider: cloudinary, aws-s3, local
FILE_STORAGE_PROVIDER=cloudinary

# Cloudinary Configuration (Recommended)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=triplecheck-files

# Local Storage Configuration
LOCAL_STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760
GENERATE_THUMBNAILS=true
ENABLE_IMAGE_OPTIMIZATION=true

# =============================================================================
# M-PESA PAYMENT CONFIGURATION
# =============================================================================
# Environment: sandbox or production
MPESA_ENVIRONMENT=sandbox

# M-Pesa API Credentials
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_BUSINESS_SHORT_CODE=174379
MPESA_PASSKEY=your_passkey

# M-Pesa URLs
MPESA_CALLBACK_URL=https://api.triplecheck.co.ke/api/payments/mpesa/callback
MPESA_RESULT_URL=https://api.triplecheck.co.ke/api/payments/mpesa/result

# M-Pesa Advanced Features (for reversals)
MPESA_INITIATOR_NAME=your_initiator_name
MPESA_SECURITY_CREDENTIAL=your_security_credential

# =============================================================================
# AI/ML SERVICE CONFIGURATION
# =============================================================================
# Default provider: openai, gemini, claude
AI_DEFAULT_PROVIDER=openai
AI_FALLBACK_MODE=false

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-vision-preview
OPENAI_MAX_TOKENS=2000

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-pro-vision

# Anthropic Claude Configuration
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-3-sonnet-20240229

# =============================================================================
# GOOGLE MAPS INTEGRATION
# =============================================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# =============================================================================
# NOTIFICATION SERVICES
# =============================================================================
# SMS Configuration (Africa's Talking or Twilio)
SMS_PROVIDER=africastalking
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=your_username

# Twilio Configuration (Alternative)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your_firebase_project
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=your_very_secure_jwt_secret_key_here
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Session Configuration
SESSION_SECRET=your_very_secure_session_secret_here
SESSION_MAX_AGE=86400000

# CORS Configuration
CORS_ORIGIN=https://triplecheck.co.ke
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# EXTERNAL API INTEGRATIONS
# =============================================================================
# Kenya Government APIs (when available)
KENYA_LANDS_API_KEY=your_lands_api_key
KENYA_LANDS_API_URL=https://api.lands.go.ke

# Court Records API
KENYA_COURTS_API_KEY=your_courts_api_key
KENYA_COURTS_API_URL=https://api.judiciary.go.ke

# Credit Reference Bureau
CRB_API_KEY=your_crb_api_key
CRB_API_URL=https://api.crb.co.ke

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
# Application Monitoring
SENTRY_DSN=your_sentry_dsn
NEW_RELIC_LICENSE_KEY=your_newrelic_key

# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
MIXPANEL_TOKEN=your_mixpanel_token

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/triplecheck.log

# =============================================================================
# CACHING & PERFORMANCE
# =============================================================================
# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# Cache Settings
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================
# Database Backup
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=triplecheck-backups

# File Backup
FILE_BACKUP_ENABLED=true
FILE_BACKUP_SCHEDULE=0 3 * * *

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
# Development Settings (set to false in production)
DEBUG_MODE=false
ENABLE_SWAGGER=false
ENABLE_GRAPHQL_PLAYGROUND=false

# Testing
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/triplecheck_test
TEST_EMAIL_RECIPIENT=test@triplecheck.co.ke

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_PROPERTY_VERIFICATION=true
ENABLE_FRAUD_DETECTION=true
ENABLE_AI_DOCUMENT_ANALYSIS=true
ENABLE_MPESA_PAYMENTS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true

# Beta Features
ENABLE_BLOCKCHAIN_VERIFICATION=false
ENABLE_ADVANCED_ANALYTICS=false
ENABLE_API_V2=false

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Deployment Platform
DEPLOYMENT_PLATFORM=vercel
DEPLOYMENT_REGION=us-east-1

# Health Check
HEALTH_CHECK_ENDPOINT=/health
HEALTH_CHECK_TIMEOUT=5000

# Graceful Shutdown
SHUTDOWN_TIMEOUT=10000

# =============================================================================
# COMPLIANCE & LEGAL
# =============================================================================
# Data Protection
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=2555
PRIVACY_POLICY_URL=https://triplecheck.co.ke/privacy

# Terms of Service
TERMS_OF_SERVICE_URL=https://triplecheck.co.ke/terms
COOKIE_POLICY_URL=https://triplecheck.co.ke/cookies

# =============================================================================
# LOCALIZATION
# =============================================================================
# Default Language
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,sw

# Currency
DEFAULT_CURRENCY=KES
CURRENCY_SYMBOL=KSh

# Timezone
DEFAULT_TIMEZONE=Africa/Nairobi

# =============================================================================
# BUSINESS CONFIGURATION
# =============================================================================
# Company Information
COMPANY_NAME=TripleCheck Kenya
COMPANY_EMAIL=info@triplecheck.co.ke
COMPANY_PHONE=+254700000000
COMPANY_ADDRESS=Nairobi, Kenya

# Service Pricing
BASIC_VERIFICATION_PRICE=2500
PREMIUM_VERIFICATION_PRICE=5000
EXPERT_CONSULTATION_PRICE=10000

# Commission Rates
PROPERTY_COMMISSION_RATE=0.025
VERIFICATION_COMMISSION_RATE=0.1

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Ensure all required services are configured
# 4. Test the configuration with: npm run test:services
# 5. Deploy to your production environment

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - Never commit this file with real credentials to version control
# - Use environment-specific configurations for dev/staging/prod
# - Rotate API keys and passwords regularly
# - Monitor for unauthorized access to your services
# - Use strong, unique passwords for all services
# - Enable 2FA where available
# - Regularly audit your security configuration

# =============================================================================
# SUPPORT & DOCUMENTATION
# =============================================================================
# For setup help, visit: https://docs.triplecheck.co.ke
# For API documentation: https://api.triplecheck.co.ke/docs
# For support: support@triplecheck.co.ke
# For emergencies: +254700000000