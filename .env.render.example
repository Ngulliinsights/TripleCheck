# TripleCheck - Render Environment Configuration
# Copy these environment variables to your Render Web Service settings

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# =============================================================================

# Application Settings
NODE_ENV=production
PORT=10000

# Database Configuration (Replace with your actual database URL)
DATABASE_URL=postgresql://username:password@host:port/database

# Security Secrets (Let Render auto-generate these or use strong random values)
JWT_SECRET=your-secure-jwt-secret-minimum-32-characters
SESSION_SECRET=your-secure-session-secret-minimum-32-characters

# CORS and URL Configuration (Replace with your actual Render app URL)
CORS_ORIGIN=https://your-app-name.onrender.com
BASE_URL=https://your-app-name.onrender.com
FRONTEND_URL=https://your-app-name.onrender.com

# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# =============================================================================

# Google Maps Integration (for property location features)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Email Service (SendGrid recommended for Render)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# FROM_EMAIL=noreply@yourdomain.com
# FROM_NAME=TripleCheck Kenya

# File Storage (Cloudinary recommended for Render)
# FILE_STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# M-Pesa Payment Integration (for Kenya)
# MPESA_ENVIRONMENT=sandbox
# MPESA_CONSUMER_KEY=your-mpesa-consumer-key
# MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
# MPESA_BUSINESS_SHORT_CODE=174379
# MPESA_PASSKEY=your-mpesa-passkey

# AI Services (optional features)
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Redis Caching (optional, for better performance)
# REDIS_URL=redis://username:password@host:port

# Monitoring and Analytics (optional)
# SENTRY_DSN=your-sentry-dsn
# GOOGLE_ANALYTICS_ID=your-ga-id

# =============================================================================
# RENDER-SPECIFIC NOTES
# =============================================================================

# 1. In Render dashboard, go to your Web Service → Environment
# 2. Add each environment variable as a key-value pair
# 3. For secrets (JWT_SECRET, SESSION_SECRET), click "Generate" for random values
# 4. For DATABASE_URL, use the Internal Database URL from your Render PostgreSQL
# 5. Replace "your-app-name" in URLs with your actual Render service name
# 6. Save and redeploy your service after adding environment variables

# =============================================================================
# SECURITY REMINDERS
# =============================================================================

# - Never commit actual secrets to version control
# - Use strong, unique passwords and API keys
# - Rotate secrets regularly
# - Enable 2FA on all external services
# - Monitor your application logs for security issues