  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "*.less",
    "./src/main.tsx",
    "./src/shared/styles/**/*"
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "bundlesize": [
    {
      "path": "./dist/public/assets/*.js",
      "maxSize": "500kb",
      "compression": "gzip"
    },
    {
      "path": "./dist/public/assets/*.css",
      "maxSize": "50kb",
      "compression": "gzip"
    }
  ]
}