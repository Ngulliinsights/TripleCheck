{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Full-stack land verification application with Express, React, and comprehensive tooling",
  "keywords": [
    "express",
    "react",
    "typescript",
    "land-verification",
    "real-estate",
    "authentication"
  ],
  "author": "Your Name",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/rest-express"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "// === DEVELOPMENT ===": "",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"API,WEB\" --prefix-colors \"blue,green\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch server/main.ts",
    "dev:fast": "tsx server/main.minimal.ts",
    "dev:optimized": "tsx server/main.optimized.ts",
    "dev:memory": "tsx --max-old-space-size=512 server/main.optimized.ts",
    "dev:gc": "node --expose-gc --loader tsx/esm server/main.optimized.ts",
    "dev:simple": "tsx server/simple-dev-server.ts",
    
    "// === BUILD & DEPLOYMENT ===": "",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.ts",
    "build:client:safe": "tsc --noEmit --skipLibCheck && vite build --config vite.config.ts",
    "build:server": "esbuild server/main.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/server --log-level=warning",
    "build:minimal": "vite build --config vite.minimal.config.ts",
    "build:optimized": "npm run build:client && npm run optimize:deployment",
    "build:analyze": "npm run build:client && npx vite-bundle-analyzer dist/public",
    "vercel-build": "npm run build:client",
    
    "// === OPTIMIZATION ===": "",
    "optimize:deployment": "node scripts/optimize-for-deployment.js",
    "optimize:aggressive": "node scripts/aggressive-optimization.js",
    "optimize:real": "node scripts/real-optimization.js",
    "implement:optimizations": "node scripts/implement-optimizations.js",
    "analyze:bundle": "npm run build:client && npx vite-bundle-analyzer dist/public",
    
    "// === SERVER MANAGEMENT ===": "",
    "start": "node dist/server/main.js",
    "start:dev": "NODE_ENV=development tsx server/main.ts",
    "start:prod": "NODE_ENV=production tsx server/main.ts",
    "preview": "vite preview --port 4173",
    "emergency-stop": "node scripts/emergency-stop.js",
    
    "// === DATABASE MANAGEMENT ===": "",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:setup": "tsx server/infrastructure/database/scripts/setup-database.ts",
    "db:reset": "tsx server/infrastructure/database/scripts/reset.ts",
    "db:status": "tsx server/infrastructure/database/scripts/status.ts",
    "db:validate": "tsx server/infrastructure/database/scripts/validate.ts",
    "db:test-connection": "tsx server/infrastructure/database/scripts/test-connection.ts",
    "db:deploy": "tsx server/infrastructure/database/scripts/deploy.ts",
    "db:consolidate": "tsx server/infrastructure/database/scripts/consolidate-schemas.ts",
    
    "// === MIGRATIONS ===": "",
    "migrate": "tsx server/infrastructure/database/migrations/migration-cli.ts migrate",
    "migrate:status": "tsx server/infrastructure/database/migrations/migration-cli.ts status",
    "migrate:validate": "tsx server/infrastructure/database/migrations/migration-cli.ts validate",
    "migrate:rollback": "tsx server/infrastructure/database/migrations/migration-cli.ts rollback",
    "migrate:list": "tsx server/infrastructure/database/migrations/migration-cli.ts list",
    "migrate:list-pending": "tsx server/infrastructure/database/migrations/migration-cli.ts list-pending",
    "migrate:list-applied": "tsx server/infrastructure/database/migrations/migration-cli.ts list-applied",
    "migrate:init": "tsx server/infrastructure/database/migrations/migration-cli.ts init",
    "migrate:dry-run": "tsx server/infrastructure/database/migrations/migration-cli.ts migrate --dry-run",
    "migrate:verbose": "tsx server/infrastructure/database/migrations/migration-cli.ts migrate --verbose",
    "migrate:help": "tsx server/infrastructure/database/migrations/migration-cli.ts help",
    "migrate:run": "tsx server/infrastructure/database/utils/migration-tools/run-migration.ts",
    "migrate:properties": "tsx server/infrastructure/database/utils/migration-tools/migrate-existing-properties.ts",
    "migrate:validate-data": "tsx server/infrastructure/database/utils/migration-tools/validate-migration.ts",
    "migrate:test-data": "tsx server/infrastructure/database/utils/migration-tools/test-migration.ts",
    "migrate:rollback-data": "tsx server/infrastructure/database/utils/migration-tools/rollback-migration.ts",
    "migrate:schema-imports": "tsx scripts/migrate-schema-imports.ts",
    
    "// === SEEDING & DATA GENERATION ===": "",
    "seed": "tsx server/infrastructure/database/scripts/seed-data.ts",
    "seed:dev": "tsx server/infrastructure/database/scripts/seed-data.ts quick-dev",
    "seed:test": "tsx server/infrastructure/database/scripts/seed-data.ts quick-test",
    "seed:performance": "tsx server/infrastructure/database/scripts/seed-data.ts performance-data",
    "seed:minimal": "tsx server/infrastructure/database/scripts/seed-data.ts generate minimal",
    "seed:clear": "tsx server/infrastructure/database/scripts/seed-data.ts clear",
    "seed:status": "tsx server/infrastructure/database/scripts/seed-data.ts status",
    "seed:validate": "tsx server/infrastructure/database/scripts/seed-data.ts validate",
    "seed:kenya": "tsx server/infrastructure/database/seeds/seed-kenya-properties.ts",
    
    "// === DATA GENERATION ===": "",
    "data:generate": "tsx server/infrastructure/database/utils/generators/data-generation/integrate-data.ts",
    "data:load": "tsx server/infrastructure/database/scripts/data-pipeline.ts",
    "data:load-robust": "tsx scripts/robust-data-loader.ts",
    "data:unified": "tsx server/infrastructure/database/scripts/unified-data-generation.ts",
    "data:unified:list": "tsx server/infrastructure/database/scripts/unified-data-generation.ts list",
    "data:unified:minimal": "tsx server/infrastructure/database/scripts/unified-data-generation.ts generate minimal",
    "data:unified:dev": "tsx database/scripts/unified-data-generation.ts generate development",
    "data:unified:test": "tsx database/scripts/unified-data-generation.ts generate testing",
    "data:unified:performance": "tsx database/scripts/unified-data-generation.ts generate performance",
    "data:unified:status": "tsx database/scripts/unified-data-generation.ts status",
    "data:unified:validate": "tsx database/scripts/unified-data-generation.ts validate",
    "data:unified:clean": "tsx database/scripts/unified-data-generation.ts clean --confirm",
    
    "// === DEMO DATA ===": "",
    "demo:scenarios": "tsx database/data-generation/cli/demo-scenario-cli.ts",
    "demo:scenario:interactive": "tsx database/data-generation/cli/demo-scenario-cli.ts interactive",
    "demo:scenario:list": "tsx database/data-generation/cli/demo-scenario-cli.ts list",
    "demo:scenario:generate": "tsx database/data-generation/cli/demo-scenario-cli.ts generate",
    "demo:scenario:executive": "tsx database/data-generation/cli/demo-scenario-cli.ts generate executive_demo",
    "demo:scenario:sales": "tsx database/data-generation/cli/demo-scenario-cli.ts generate sales_demo",
    "demo:scenario:technical": "tsx database/data-generation/cli/demo-scenario-cli.ts generate technical_demo",
    "demo:generate": "tsx database/data-generation/cli/demo-generator-cli.ts",
    "demo:quick": "tsx database/data-generation/cli/demo-generator-cli.ts quick",
    "demo:all": "tsx database/data-generation/cli/demo-generator-cli.ts all",
    "demo:validate": "tsx database/data-generation/cli/demo-generator-cli.ts validate",
    "demo:clean": "tsx database/data-generation/cli/demo-generator-cli.ts clean",
    
    "// === SECURITY ===": "",
    "security": "tsx server/infrastructure/database/security/security-cli.ts",
    "security:init": "tsx server/infrastructure/database/security/security-cli.ts init",
    "security:status": "tsx server/infrastructure/database/security/security-cli.ts status",
    "security:scan": "tsx server/infrastructure/database/security/security-cli.ts scan",
    "security:monitor": "tsx server/infrastructure/database/security/security-cli.ts monitor",
    "security:report": "tsx server/infrastructure/database/security/security-cli.ts report",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix",
    "security:snyk:scan": "snyk test",
    "security:snyk:monitor": "snyk monitor",
    "security:analyze": "tsx scripts/security/bug-categorization.ts",
    "security:full": "npm run security:audit && npm run security:snyk:scan && npm run lint:security && npm run security:analyze",
    
    "// === TESTING ===": "",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/test-integration.js",
    
    "// === UI AUDIT SYSTEM ===": "",
    "audit:ui": "tsx src/infrastructure/audit/cli.ts",
    "audit:ui:quick": "tsx src/infrastructure/audit/cli.ts --quick",
    "audit:ui:focused": "tsx src/infrastructure/audit/cli.ts --focused",
    "audit:ui:accessibility": "tsx src/infrastructure/audit/cli.ts --focused --focus accessibility",
    "audit:ui:performance": "tsx src/infrastructure/audit/cli.ts --focused --focus performance",
    "audit:ui:security": "tsx src/infrastructure/audit/cli.ts --focused --focus security",
    "audit:ui:connectivity": "tsx src/infrastructure/audit/cli.ts --focused --focus connectivity",
    "audit:ui:json": "tsx src/infrastructure/audit/cli.ts --format json --output reports/audit",
    "audit:ui:markdown": "tsx src/infrastructure/audit/cli.ts --format markdown --output reports/audit",
    "audit:ui:html": "tsx src/infrastructure/audit/cli.ts --format html --output reports/audit",
    "audit:ui:all-formats": "tsx src/infrastructure/audit/cli.ts --format json,markdown,html --output reports/audit",
    "audit:ui:watch": "tsx src/infrastructure/audit/cli.ts --watch --quick",
    "audit:ui:ci": "tsx src/infrastructure/audit/cli.ts --quick --format json --output reports/audit --no-parallel",
    "audit:ui:verbose": "tsx src/infrastructure/audit/cli.ts --verbose",
    "audit:ui:notify": "tsx src/infrastructure/audit/cli.ts --notify --format markdown",
    "test:e2e": "playwright test",
    "test:e2e:auth": "node scripts/run-e2e-tests.js --suite auth",
    "test:e2e:property": "node scripts/run-e2e-tests.js --suite property",
    "test:e2e:profile": "node scripts/run-e2e-tests.js --suite profile",
    "test:e2e:headed": "node scripts/run-e2e-tests.js --headed",
    "test:e2e:debug": "node scripts/run-e2e-tests.js --debug",
    "test:e2e:quick": "node scripts/run-e2e-tests.js --quick",
    "test:visual": "node scripts/run-visual-tests.js",
    "test:visual:update": "node scripts/run-visual-tests.js --update",
    "test:visual:components": "node scripts/run-visual-tests.js --test components",
    "test:responsive": "node scripts/run-visual-tests.js --test responsive-design",
    "test:performance": "vitest run server/tests/performance.test.ts",
    "test:load": "tsx server/tests/load-test.ts",
    "test:compatibility": "tsx server/tests/run-compatibility-tests.ts",
    "test:backward-compatibility": "vitest run server/tests/backward-compatibility.test.ts",
    "test:land-verification": "tsx server/land-verification/__tests__/run-comprehensive-tests.ts",
    "test:deployment": "tsx scripts/deployment/deployment-tests.ts",
    "test:build": "tsx scripts/test-build.ts",
    
    "// === DISASTER RECOVERY ===": "",
    "dr:init": "tsx database/disaster-recovery/disaster-recovery-cli.ts init",
    "dr:health-check": "tsx database/disaster-recovery/disaster-recovery-cli.ts health-check",
    "dr:recover": "tsx database/disaster-recovery/disaster-recovery-cli.ts recover",
    "dr:test": "tsx database/disaster-recovery/disaster-recovery-cli.ts test",
    "dr:test-all": "tsx database/disaster-recovery/disaster-recovery-cli.ts test --all",
    "dr:backup:full": "tsx database/disaster-recovery/disaster-recovery-cli.ts backup --full",
    "dr:backup:incremental": "tsx database/disaster-recovery/disaster-recovery-cli.ts backup --incremental",
    "dr:backup:status": "tsx database/disaster-recovery/disaster-recovery-cli.ts backup --status",
    "dr:monitor": "tsx database/disaster-recovery/disaster-recovery-cli.ts monitor",
    
    "// === DEPLOYMENT ===": "",
    "deploy:setup": "tsx scripts/deploy-setup.ts",
    "deploy:vercel": "vercel --prod",
    "deploy:preview": "vercel",
    "deploy:render": "node scripts/deploy-render.js",
    "deploy:minimal": "npm run build:client && node scripts/deploy-minimal.js",
    "deploy:optimized": "npm run deploy:minimal && npm run analyze:bundle",
    "deploy:production": "npm run prepare:vercel && npm run deploy:vercel",
    "deploy:staging": "npm run prepare:staging && npm run deploy:preview",
    "prepare:deployment": "tsx scripts/prepare-deployment.ts",
    "prepare:vercel": "tsx scripts/prepare-deployment.ts vercel production basic",
    "prepare:staging": "tsx scripts/prepare-deployment.ts vercel staging basic",
    
    "// === MONITORING & HEALTH ===": "",
    "monitor:start": "tsx scripts/self-monitoring-pipeline.ts",
    "monitor:validate": "tsx scripts/self-monitoring-pipeline.ts --validate-once",
    "monitor:health": "tsx scripts/self-monitoring-pipeline.ts --health",
    "monitor:metrics": "tsx scripts/self-monitoring-pipeline.ts --metrics",
    "health:check": "tsx scripts/health-check.ts",
    "health:summary": "tsx scripts/health-check.ts summary",
    "health:monitor": "watch -n 30 'npm run health:summary'",
    "integrity:check": "tsx scripts/data-integrity-checker.ts",
    "integrity:quick": "tsx scripts/data-integrity-checker.ts --quick",
    
    "// === HOOKS & MIGRATION UTILITIES ===": "",
    "hooks:analyze": "node scripts/analyze-hooks.js",
    "hooks:consolidation-status": "tsx -e \"import('./src/shared/hooks/utils/deprecation.js').then(m => m.checkDeprecatedHookUsage())\"",
    "migrate:detect": "node scripts/migrate-hooks.js detect",
    "migrate:fix": "node scripts/migrate-hooks.js fix",
    "migration:orchestrate": "tsx .kiro/specs/project-migration-refactoring/task-orchestrator.ts start",
    "migration:status": "tsx .kiro/specs/project-migration-refactoring/task-orchestrator.ts status",
    "migration:next-task": "tsx .kiro/specs/project-migration-refactoring/task-orchestrator.ts next",
    
    "// === CODE QUALITY ===": "",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:security": "eslint . --config eslint.config.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    
    "// === UTILITIES ===": "",
    "clean": "rm -rf dist coverage .turbo node_modules/.cache",
    "clean:deps": "rm -rf node_modules package-lock.json && npm install",
    "setup:dev": "node scripts/setup-dev.js",
    "setup:monitoring": "tsx scripts/deployment/setup-monitoring.ts",
    "validate:database-paths": "tsx scripts/validate-database-paths.ts",
    "validate:production": "tsx scripts/validate-production.ts",
    "pre-deploy": "npm run validate:production && npm run health:check",
    "debug:vercel": "tsx scripts/debug-vercel-deployment.ts",
    "debug:blank": "tsx scripts/debug-blank-page.ts",
    "prepare": "husky install"
  },
