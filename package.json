{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Full-stack application with Express, React, and blockchain integration",
  "keywords": [
    "express",
    "react",
    "blockchain",
    "web3",
    "typescript"
  ],
  "author": "Your Name",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/rest-express"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/server",
    "vercel-build": "npm run build",
    "start": "NODE_ENV=production node dist/server/index.js",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:setup": "tsx scripts/setup-database.ts",
    "test:setup": "node test-setup.js",
    "data:generate": "tsx scripts/data-generation/integrate-data.ts",
    "data:load": "tsx scripts/load-generated-data.ts",
    "data:properties": "python scripts/data-generation/property-generator.py",
    "data:users": "python scripts/data-generation/user-generator.py",
    "data:fraud": "python scripts/data-generation/fraud-simulator.py",
    "postinstall": "npm run build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "clean": "rm -rf dist coverage .turbo",
    "prepare": "husky install"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.9.1",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.1",
