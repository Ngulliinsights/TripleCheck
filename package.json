{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Full-stack land verification application with Express, React, and comprehensive tooling",
  "keywords": [
    "express",
    "react",
    "typescript",
    "land-verification",
    "real-estate",
    "authentication"
  ],
  "author": "Your Name",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/rest-express"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "// === CORE DEVELOPMENT ===": "",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"API,WEB\" --prefix-colors \"blue,green\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch server/main.ts",
    "dev:optimized": "NODE_OPTIONS=\"--max-old-space-size=512\" tsx watch server/main.optimized.ts",
    
    "// === BUILD SYSTEM ===": "",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "esbuild server/main.ts --platform=node --packages=external --bundle --format=esm --outdir=dist/server --log-level=warning",
    "build:analyze": "npm run build:client && npx vite-bundle-analyzer dist/public",
    "build:production": "NODE_ENV=production npm run build && npm run optimize:bundle",
    "optimize:bundle": "tsx server/infrastructure/optimization/BundleOptimizer.ts",
    
    "// === SERVER MANAGEMENT ===": "",
    "start": "node dist/server/main.js",
    "start:dev": "NODE_ENV=development tsx server/main.ts",
    "start:prod": "NODE_ENV=production tsx server/main.ts",
    "preview": "vite preview --port 4173",
    
    "// === DATABASE OPERATIONS ===": "",
    "db:setup": "tsx server/infrastructure/database/scripts/setup-database.ts",
    "db:status": "tsx server/infrastructure/database/scripts/status.ts",
    "db:reset": "tsx server/infrastructure/database/scripts/reset.ts && npm run db:migrate && npm run db:seed:dev",
    "db:studio": "drizzle-kit studio",
    
    "// === MIGRATIONS (Unified System) ===": "",
    "db:migrate": "tsx server/infrastructure/database/migrations/migration-cli.ts migrate",
    "db:migrate:status": "tsx server/infrastructure/database/migrations/migration-cli.ts status",
    "db:migrate:rollback": "tsx server/infrastructure/database/migrations/migration-cli.ts rollback",
    "db:migrate:dry-run": "tsx server/infrastructure/database/migrations/migration-cli.ts migrate --dry-run",
    "db:migrate:validate": "tsx server/infrastructure/database/migrations/migration-cli.ts validate",
    
    "// === DATA MANAGEMENT ===": "",
    "db:seed": "tsx server/infrastructure/database/scripts/unified-data-generation.ts generate",
    "db:seed:dev": "tsx server/infrastructure/database/scripts/unified-data-generation.ts generate development",
    "db:seed:test": "tsx server/infrastructure/database/scripts/unified-data-generation.ts generate testing",
    "db:seed:performance": "tsx server/infrastructure/database/scripts/unified-data-generation.ts generate performance",
    "db:seed:minimal": "tsx server/infrastructure/database/scripts/unified-data-generation.ts generate minimal",
    "db:seed:clear": "tsx server/infrastructure/database/scripts/unified-data-generation.ts clean --confirm",
    "db:seed:status": "tsx server/infrastructure/database/scripts/unified-data-generation.ts status",
    
    "// === DEMO DATA SYSTEM ===": "",
    "demo": "tsx database/data-generation/cli/demo-scenario-cli.ts interactive",
    "demo:executive": "tsx database/data-generation/cli/demo-scenario-cli.ts generate executive_demo",
    "demo:sales": "tsx database/data-generation/cli/demo-scenario-cli.ts generate sales_demo",
    "demo:technical": "tsx database/data-generation/cli/demo-scenario-cli.ts generate technical_demo",
    "demo:validate": "tsx database/data-generation/cli/demo-generator-cli.ts validate",
    "demo:clean": "tsx database/data-generation/cli/demo-generator-cli.ts clean",
    
    "// === COMPREHENSIVE TESTING ===": "",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit",
    
    "// === END-TO-END TESTING ===": "",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:auth": "playwright test --grep=\"auth\"",
    "test:e2e:property": "playwright test --grep=\"property\"",
    
    "// === SPECIALIZED TESTING ===": "",
    "test:performance": "vitest run server/tests/performance.test.ts",
    "test:load": "tsx server/tests/load-test.ts",
    "test:compatibility": "tsx server/tests/run-compatibility-tests.ts",
    "test:land-verification": "tsx server/land-verification/__tests__/run-comprehensive-tests.ts",
    "test:visual": "playwright test --config=playwright-visual.config.ts",
    "test:visual:update": "playwright test --config=playwright-visual.config.ts --update-snapshots",
    
    "// === SECURITY & AUDITING ===": "",
    "security:audit": "npm audit && snyk test",
    "security:audit:fix": "npm audit fix",
    "security:scan": "tsx server/infrastructure/database/security/security-cli.ts scan",
    "security:monitor": "tsx server/infrastructure/database/security/security-cli.ts monitor",
    "security:report": "tsx server/infrastructure/database/security/security-cli.ts report",
    
    "// === UI AUDIT SYSTEM ===": "",
    "audit:ui": "tsx src/infrastructure/audit/cli.ts",
    "audit:ui:accessibility": "tsx src/infrastructure/audit/cli.ts --focused --focus accessibility",
    "audit:ui:performance": "tsx src/infrastructure/audit/cli.ts --focused --focus performance",
    "audit:ui:security": "tsx src/infrastructure/audit/cli.ts --focused --focus security",
    "audit:ui:watch": "tsx src/infrastructure/audit/cli.ts --watch --quick",
    "audit:ui:ci": "tsx src/infrastructure/audit/cli.ts --quick --format json --output reports/audit --no-parallel",
    
    "// === DISASTER RECOVERY ===": "",
    "dr:health-check": "tsx database/disaster-recovery/disaster-recovery-cli.ts health-check",
    "dr:backup": "tsx database/disaster-recovery/disaster-recovery-cli.ts backup --full",
    "dr:backup:incremental": "tsx database/disaster-recovery/disaster-recovery-cli.ts backup --incremental",
    "dr:recover": "tsx database/disaster-recovery/disaster-recovery-cli.ts recover",
    "dr:test": "tsx database/disaster-recovery/disaster-recovery-cli.ts test",
    
    "// === DEPLOYMENT ===": "",
    "deploy:setup": "npm run prepare:deployment && npm run validate:production",
    "deploy:vercel": "npm run build:production && vercel --prod",
    "deploy:preview": "npm run build && vercel",
    "prepare:deployment": "tsx scripts/prepare-deployment.ts",
    "validate:production": "tsx scripts/validate-production.ts && npm run health:check",
    
    "// === MONITORING & HEALTH ===": "",
    "health:check": "tsx scripts/health-check.ts",
    "health:summary": "tsx scripts/health-check.ts summary",
    "health:monitor": "watch -n 30 'npm run health:summary'",
    "monitor:start": "tsx scripts/self-monitoring-pipeline.ts",
    "monitor:validate": "tsx scripts/self-monitoring-pipeline.ts --validate-once",
    "integrity:check": "tsx scripts/data-integrity-checker.ts",
    
    "// === CODE QUALITY ===": "",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:security": "eslint . --config eslint.security.config.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "check": "npm run test:types && npm run lint && npm run format:check",
    
    "// === CORE UTILITIES MIGRATION ===": "",
    "migrate:core-utilities": "tsx scripts/run-migration.ts",
    "migrate:core-utilities:dry-run": "tsx scripts/run-migration.ts --dry-run",
    "migrate:core-utilities:verbose": "tsx scripts/run-migration.ts --verbose",
    "migrate:cache": "tsx scripts/migration-helpers/cache-migration.ts",
    "migrate:middleware": "tsx scripts/migration-helpers/middleware-migration.ts",
    "migrate:config": "tsx scripts/migration-helpers/config-migration.ts",
    "validate:migration": "tsx scripts/validate-migration.ts",
    
    "// === MAINTENANCE ===": "",
    "clean": "rm -rf dist coverage .turbo node_modules/.cache",
    "clean:full": "npm run clean && rm -rf node_modules package-lock.json && npm install",
    "setup:dev": "npm install && npm run db:setup && npm run db:seed:dev",
    "setup:production": "npm install --omit=dev && npm run build:production",
    
    "// === CI/CD HELPERS ===": "",
    "ci:test": "npm run check && npm run test:coverage && npm run test:e2e",
    "ci:security": "npm run security:audit && npm run lint:security",
    "ci:deploy": "npm run ci:test && npm run ci:security && npm run deploy:setup",
    "prepare": "husky install"
  },
