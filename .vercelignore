# Development files
.env
.env.local
.env.development
.env.test

# Source files (not needed for static deployment)
src/
server/
scripts/
tests/
docs/
reports/
uploads/
temp-files/
test-results/
playwright-report/
migrations/

# Development dependencies
node_modules/
.cache/
.vscode/
.git/
.github/
.husky/

# Build artifacts not needed
*.log
*.tsbuildinfo
coverage/
.nyc_output/

# Large unnecessary files
*.md
!README.md
desktop.ini
nul

# Test configurations
vitest.*.config.ts
playwright.config.ts
*.test.*
*.spec.*

# Development configs
tsconfig.*.json
!tsconfig.json
eslint.config.js
.snyk

# Python virtual environment
.venv/
__pycache__/

# Temporary files
*.tmp
*.temp
*-temp.*

# Large asset directories that aren't needed
srclib/
srcsharedtest-utils/
config/

# Keep only essential files for deployment
!dist/
!package.json
!vercel.json