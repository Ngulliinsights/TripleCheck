# TRIPLECHECK PRODUCTION ENVIRONMENT CONFIGURATION
# ================================================

# Application Environment
NODE_ENV=production

# Database Configuration (Production)
# Replace with your production database URL
DATABASE_URL="postgresql://username:password@your-production-db.com:5432/triplecheck?sslmode=require"

# Database Connection Settings (Production Optimized)
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=60000
DB_ACQUIRE_TIMEOUT=90000
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2

# Security Configuration
# IMPORTANT: Generate a strong, unique JWT secret for production
JWT_SECRET="your-super-secure-production-jwt-secret-key-here"
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Server Configuration
PORT=3001
FRONTEND_URL="https://your-domain.com"

# Email Configuration (Production SMTP)
SMTP_HOST="smtp.your-email-provider.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-production-email@your-domain.com"
SMTP_PASS="your-production-email-password"

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="jpg,jpeg,png,pdf,doc,docx"

# M-Pesa Configuration (Production)
MPESA_CONSUMER_KEY="your-production-mpesa-consumer-key"
MPESA_CONSUMER_SECRET="your-production-mpesa-consumer-secret"
MPESA_BUSINESS_SHORT_CODE="your-production-business-short-code"
MPESA_PASSKEY="your-production-mpesa-passkey"
MPESA_ENVIRONMENT="production"

# Google Maps API Key (Production)
VITE_GOOGLE_MAPS_API_KEY="your-production-google-maps-api-key"

# Redis Configuration (if using Redis for caching)
REDIS_URL="redis://your-redis-instance:6379"

# Monitoring and Logging
LOG_LEVEL="info"
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_TRACKING=true

# Security Headers
ENABLE_HELMET=true
ENABLE_CORS=true
CORS_ORIGIN="https://your-domain.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET="your-super-secure-session-secret"
SESSION_MAX_AGE=86400000

# Feature Flags
ENABLE_LAND_VERIFICATION=true
ENABLE_FRAUD_DETECTION=true
ENABLE_COMMUNITY_FEATURES=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_ANALYTICS=true

# External Service URLs
LAND_REGISTRY_API_URL="https://api.landregistry.go.ke"
FRAUD_DETECTION_API_URL="https://api.frauddetection.service.com"

# CDN Configuration (if using CDN)
CDN_URL="https://cdn.your-domain.com"
STATIC_ASSETS_URL="https://assets.your-domain.com"

# Backup Configuration
ENABLE_AUTOMATED_BACKUPS=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=0.1

# Error Reporting (e.g., Sentry)
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ENVIRONMENT="production"

# Analytics (if using Google Analytics, etc.)
GOOGLE_ANALYTICS_ID="GA-XXXXXXXXX"
ENABLE_ANALYTICS_TRACKING=true